/* ---------------------------------------------------------------------------
 * Scroll lock
 *
 * The page stops scrolling while a popover with data-scroll-lock is open, with
 * no JS. The gutter stays reserved so the content doesn't shift sideways.
 *
 *   <div popover data-scroll-lock>…</div>
 *
 * For anything else that should lock scrolling, add no-scroll to <html>.
 * ------------------------------------------------------------------------- */

@layer base {
    html:has([popover][data-scroll-lock]:where(:popover-open, .\:popover-open)) {
        overflow: hidden;
        scrollbar-gutter: stable;
    }
}
