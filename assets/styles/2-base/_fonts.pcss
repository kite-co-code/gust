/* ---------------------------------------------------------------------------
 * Fonts
 *
 * Kite Co.'s IBM Plex family, self-hosted from assets/static/fonts/ (Latin
 * subsets; SIL Open Font License, see OFL.txt). Wired to the theme in
 * 1-theme/_tailwind-theme.pcss and preloaded in Theme/Modules/Core/Preloads.php:
 *   --font-serif   IBM Plex Serif Medium     headings, captions
 *   --font-mono    IBM Plex Mono SemiBold    labels, nav, tags, buttons (Regular for code)
 *   --font-sans    IBM Plex Sans             body
 * ------------------------------------------------------------------------- */

@font-face {
    font-display: swap;
    font-family: "IBM Plex Serif";
    font-style: normal;
    font-weight: 500;
    src: url("/fonts/ibm-plex-serif-medium.woff2") format("woff2");
}

@font-face {
    font-display: swap;
    font-family: "IBM Plex Serif";
    font-style: italic;
    font-weight: 500;
    src: url("/fonts/ibm-plex-serif-medium-italic.woff2") format("woff2");
}

@font-face {
    font-display: swap;
    font-family: "IBM Plex Mono";
    font-style: normal;
    font-weight: 400;
    src: url("/fonts/ibm-plex-mono.woff2") format("woff2");
}

@font-face {
    font-display: swap;
    font-family: "IBM Plex Mono";
    font-style: normal;
    font-weight: 600;
    src: url("/fonts/ibm-plex-mono-semibold.woff2") format("woff2");
}

/* Variable weight */
@font-face {
    font-display: swap;
    font-family: "IBM Plex Sans";
    font-style: normal;
    font-weight: 100 700;
    src: url("/fonts/ibm-plex-sans.woff2") format("woff2");
}

@font-face {
    font-display: swap;
    font-family: "IBM Plex Sans";
    font-style: italic;
    font-weight: 400;
    src: url("/fonts/ibm-plex-sans-italic.woff2") format("woff2");
}
