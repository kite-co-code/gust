/* ---------------------------------------------------------------------------
 * Site header
 *
 * A sticky header whose nav is inline from the site-header breakpoint up, and
 * a popover panel below the bar under it. The mobile search is a second
 * popover panel. Popovers do the work with no JS: the toggles get
 * aria-expanded, Escape and a click outside close them, opening one closes
 * the other, and focus goes back to the toggle. Panels wipe open with
 * @starting-style; data-scroll-lock stops the page scrolling behind them
 * (4-utilities/_scroll-lock.pcss).
 *
 * scripts/SiteHeader.js adds the rest: it sets [data-site-header-hidden]
 * while the user scrolls down and removes it when they scroll up, so the
 * header peeks back. It also closes panels on a link click, when focus leaves
 * them, and when the viewport grows past the breakpoint. Without JS the header
 * just stays put. Keyboard focus or an open panel always brings a hidden
 * header back.
 *
 * Toggle contents show by panel state: .site-header__toggle-closed while the
 * toggle's panel is closed, .site-header__toggle-open while it's open.
 * ------------------------------------------------------------------------- */

@import './styles/_menu.pcss';

@layer base {
    :root {
        --site-header--height: space(70);
        /* The fixed admin bar. Under 600px it scrolls away with the page. */
        --site-header--top: var(--wp-admin--admin-bar--height, 0px);
        --site-header--menu--duration: 250ms;
        --site-header--menu--ease: ease-in-out;

        @media (width < 600px) {
            --site-header--top: 0px;
        }

        @media (width >= theme('screens.site-header')) {
            --site-header--height: space(74);
        }
    }
}

.site-header {
    --site-header--spacing: space(12);
    --site-header--icon-size: 18px;
    --site-header--logo-width: space(80);
    --site-header--transition-duration: 300ms;

    --link--color: var(--color-foreground);
    --link--color-hover: var(--color-foreground);
    --link--text-decoration: none;
    --link--text-decoration--hover: underline;

    --menu-item--gap: space(24);
    --menu-item--arrow-size: 0.8125rem;

    position: sticky;
    top: var(--site-header--top);
    z-index: var(--z-index-site-header);
    background-color: var(--color-background);

    @media (width >= theme('screens.site-header')) {
        --site-header--spacing: space(20);
        --site-header--logo-width: space(96);
        --menu-item--arrow-size: 0.625rem;
        --menu-item--gap: space(32);
    }

    @media (prefers-reduced-motion: no-preference) {
        transition: translate var(--site-header--transition-duration) var(--ease-out-quart);
    }

    /* Scrolled away, unless keyboard focus is in it or a panel is open */
    &[data-site-header-hidden]:not(:has(:focus-visible, :where(:popover-open, .\:popover-open))) {
        translate: 0 -100%;
    }
}

.site-header__bar {
    display: flex;
    width: 100%;
    height: var(--site-header--height);
    align-items: center;
    padding-right: var(--container-padding);
    padding-left: var(--container-padding);
    gap: var(--site-header--spacing);
    justify-content: space-between;

    @media (width >= theme('screens.site-header')) {
        @apply content-width-fluid-lg;

        padding-right: 0;
        padding-left: 0;
    }
}

.site-header__logo {
    display: flex;
    width: 100%;
    max-width: var(--site-header--logo-width);
    height: 100%;
    max-height: calc(100% - space(8));
    margin-right: auto;

    > * {
        object-fit: contain;
        object-position: left center;
    }
}

.site-header__buttons {
    display: flex;
    align-items: center;
    gap: space(20);

    @media (width >= theme('screens.site-header')) {
        display: none;
    }

    .btn {
        line-height: 1.25;
    }
}

.site-header__burger {
    flex: 0 0 auto;
    margin-right: calc(var(--burger--padding) * -0.5);
}

.site-header__search-toggler {
    --btn--icon-size: rem(18px);

    position: relative;
    flex: 0 0 auto;
}

/* Toggle contents by the state of the toggle's panel */
.site-header:not(:has(.site-header__nav:where(:popover-open, .\:popover-open))) .site-header__burger .site-header__toggle-open,
.site-header:has(.site-header__nav:where(:popover-open, .\:popover-open)) .site-header__burger .site-header__toggle-closed,
.site-header:not(:has(.site-header__search-panel:where(:popover-open, .\:popover-open)))
    .site-header__toggle.site-header__search-toggler
    .site-header__toggle-open,
.site-header:has(.site-header__search-panel:where(:popover-open, .\:popover-open))
    .site-header__toggle.site-header__search-toggler
    .site-header__toggle-closed {
    display: none;
}

/* The burger crosses while the menu is open */
.site-header:has(.site-header__nav:where(:popover-open, .\:popover-open)) .site-header__burger .burger {
    .burger__line--1 {
        transform: rotate(45deg);
    }

    .burger__line--2 {
        opacity: 0;
    }

    .burger__line--3 {
        transform: rotate(-45deg);
    }
}

/* Mobile: a panel filling the viewport below the bar */
.site-header__panel {
    @media (width < theme('screens.site-header')) {
        position: fixed;
        inset: var(--site-header__panel--top, calc(var(--site-header--top) + var(--site-header--height))) 0 0;
        width: auto;
        height: auto;
        max-width: none;
        max-height: none;
        margin: 0;
        padding: var(--container-padding);
        border: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        background-color: var(--color-background);
        color: var(--color-foreground);
        /* Outside the open state so the layout holds while the panel closes */
        flex-direction: column;

        &:where(:popover-open, .\:popover-open) {
            display: flex;
        }

        /*
         * Wipe down from the bar, then fade the contents in. display and
         * overlay keep it in the top layer until the closing transition ends.
         */
        @media (prefers-reduced-motion: no-preference) {
            clip-path: inset(0 0 100%);
            transition:
                clip-path var(--site-header--menu--duration) var(--site-header--menu--ease),
                display var(--site-header--menu--duration) allow-discrete,
                overlay var(--site-header--menu--duration) allow-discrete;

            & > * {
                opacity: 0;
                translate: 0 10px;
                transition:
                    opacity calc(var(--site-header--menu--duration) + 100ms) var(--site-header--menu--ease),
                    translate calc(var(--site-header--menu--duration) + 100ms) var(--site-header--menu--ease);
            }

            &:where(:popover-open, .\:popover-open) {
                clip-path: inset(0);

                & > * {
                    opacity: 1;
                    translate: 0 0;
                }
            }

            @starting-style {
                &:where(:popover-open, .\:popover-open) {
                    clip-path: inset(0 0 100%);

                    & > * {
                        opacity: 0;
                        translate: 0 10px;
                    }
                }
            }
        }
    }
}

.site-header__nav {
    @media (width < theme('screens.site-header')) {
        gap: var(--menu-item--gap);
        padding-top: space(40);
    }

    /* Inline: undo the UA popover styles so the closed popover shows in the bar */
    @media (width >= theme('screens.site-header')) {
        position: relative;
        inset: auto;
        display: flex;
        width: auto;
        height: auto;
        align-items: center;
        margin: 0;
        padding: 0;
        border: 0;
        overflow: visible;
        background-color: transparent;
        color: inherit;
        gap: var(--site-header--spacing);
    }
}

.site-header__search-panel {
    align-items: center;
    justify-content: center;
}

.site-header__search-desktop-wrapper {
    position: relative;
    display: flex;
    align-items: center;

    @media (width < theme('screens.site-header')) {
        display: none;
    }
}

.site-header__search-desktop {
    position: absolute;
    right: 100%;
    display: flex;
    align-items: center;
    opacity: 0;
    pointer-events: none;
    transition:
        opacity var(--site-header--menu--duration) var(--site-header--menu--ease),
        visibility var(--site-header--menu--duration);
    visibility: hidden;
    background-color: var(--color-neutral);
    width: 450px;

    .header-search {
        max-width: unset;
    }

    &:not([hidden]) {
        display: flex;
        opacity: 1;
        pointer-events: auto;
        visibility: visible;
    }
}

.site-header__search-close {
    --btn--icon-size: space(18);

    padding: 0;
    border: 0;
}
