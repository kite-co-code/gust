.site-header__navigation {
    --menu-item--gap: space(24);
    --menu-item--arrow-size: 0.8125rem; /* 13px */

    align-self: start;

    @media (min-width: theme('screens.site-header')) {
        --menu-item--arrow-size: 0.625rem; /* 10px */
        --menu-item--gap: space(32);

        display: flex;
        height: 100%;
        flex-flow: row nowrap;
        align-self: unset;
        padding: 0;
    }

    a {
        @apply link--2;

        display: inline-flex;

        @media (width < theme('screens.site-header')) {
            @apply type-h3;
        }

        &:not([href]) {
            cursor: default;
        }
    }

    .menu__inner {
        display: flex;
    }

    .menu-list {
        display: grid;
        width: 100%;
        align-items: stretch;
        gap: var(--menu-item--gap);
        text-align: left;

        @media (min-width: theme('screens.site-header')) {
            position: static;
            border-bottom: 0;
            grid-auto-flow: column;
            text-align: center;
        }
    }

    .menu-item {
        display: block;

        /* Top level menu items */
        &:where(.menu-item--depth-0) {
            @media (min-width: theme('screens.site-header')) {
                position: relative;
                display: flex;
                align-items: stretch;
            }
        }

        :where(.menu-item__wrap) {
            display: flex;
            align-items: center;
            justify-content: flex-start;

            @media (width < theme('screens.site-header')) {
                min-height: 2.75rem; /* 44px */
            }
        }

        /* Dropdown menu items */
        &:where(.menu-item--has-children) {
            &:hover,
            &:focus {
                > a {
                    color: var(--link--color-hover);
                }
            }
        }

        /* Sub-menu toggle (Disclosure, see components/menu/menu-item) */
        :where(.sub-menu-toggler) {
            @apply btn--unstyled;

            display: inline-flex;
            width: 2.75rem; /* 44px */
            height: 2.75rem;
            flex: 0 0 auto;
            align-items: center;
            justify-content: center;
            color: var(--link--color, currentColor);

            @media (min-width: theme('screens.site-header')) {
                width: 1.5rem;
                height: 1.5rem;
            }

            &::before {
                width: var(--menu-item--arrow-size);
                height: var(--menu-item--arrow-size);
                background-color: currentColor;
                content: '';
                mask-image: url('/images/icons/chevron-down.svg');
                mask-position: center;
                mask-repeat: no-repeat;
                mask-size: contain;
                transition: transition(transform);
            }

            &[aria-expanded='true']::before {
                transform: rotate(180deg);
            }
        }

        :where(.sub-menu) {
            padding-inline-start: space(16);

            .menu-list {
                gap: space(12);
                padding-block: space(12);
            }

            a {
                @media (width < theme('screens.site-header')) {
                    @apply type-h4;
                }
            }
        }

        /* Desktop: top-level sub-menus drop down below their item */
        @media (min-width: theme('screens.site-header')) {
            :where(.sub-menu--depth-0) {
                position: absolute;
                z-index: 1;
                top: 100%;
                left: 0;
                min-width: 14rem;
                padding: space(4) space(16);
                border: var(--base--border);
                border-radius: var(--radius-sm);
                background-color: var(--color-background);
                box-shadow: var(--base--shadow);
                text-align: left;

                .menu-list {
                    grid-auto-flow: row;
                    text-align: left;
                }
            }
        }

        /* The active menu item */
        &:where(.menu-item--current) {
            > .menu-item__wrap a {
                --link--text-decoration: underline;
            }
        }
    }
}
