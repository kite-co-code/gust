			count: 3
			path: Gust/WordPress/Cleanup.php

		-
			message: '#^Access to property \$base on an unknown class Gust\\WordPress\\WP_Screen\.$#'
			identifier: class.notFound
			count: 2
			path: Gust/WordPress/Comments.php

