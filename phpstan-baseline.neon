parameters:
	ignoreErrors:
		-
			message: '#^PHPDoc tag @return with type string is incompatible with native type array\.$#'
			identifier: return.phpDocType
			count: 1
			path: Gust/Asset.php

		-
			message: '#^Action callback returns string but should not return anything\.$#'
			identifier: return.void
			count: 1
			path: Gust/Component.php

		-
			message: '#^Unsafe usage of new static\(\)\.$#'
			identifier: new.static
			count: 1
			path: Gust/ComponentBase.php

		-
			message: '#^Unsafe access to private property Gust\\Config\:\:\$config through static\:\:\.$#'
			identifier: staticClassAccess.privateProperty
			count: 5
			path: Gust/Config.php

		-
			message: '#^Unsafe call to private method Gust\\Config\:\:load\(\) through static\:\:\.$#'
			identifier: staticClassAccess.privateMethod
			count: 1
			path: Gust/Config.php

		-
			message: '#^PHPDoc tag @param references unknown parameter\: \$attrs$#'
			identifier: parameter.notFound
			count: 1
			path: Gust/SVG.php

		-
			message: '#^Parameter \#1 \$svg of static method Gust\\SVG\:\:info\(\) expects Gust\\DOMDocument\|string, DOMDocument given\.$#'
			identifier: argument.type
			count: 1
			path: Gust/SVG.php

		-
			message: '#^Parameter \$svg of method Gust\\SVG\:\:attrs\(\) has invalid type Gust\\DOMDocument\.$#'
			identifier: class.notFound
			count: 1
			path: Gust/SVG.php

		-
			message: '#^Parameter \$svg of method Gust\\SVG\:\:info\(\) has invalid type Gust\\DOMDocument\.$#'
			identifier: class.notFound
			count: 1
			path: Gust/SVG.php

		-
			message: '#^Call to method add_menu\(\) on an unknown class Gust\\WordPress\\WP_Admin_Bar\.$#'
			identifier: class.notFound
			count: 1
			path: Gust/WordPress/Admin.php

		-
			message: '#^Parameter \$adminBar of method Gust\\WordPress\\Admin\:\:addViewAllPostsToArchivePages\(\) has invalid type Gust\\WordPress\\WP_Admin_Bar\.$#'
			identifier: class.notFound
			count: 1
			path: Gust/WordPress/Admin.php

		-
			message: '#^Property WP_Post_Type\:\:\$menu_position \(int\) on left side of \?\? is not nullable\.$#'
