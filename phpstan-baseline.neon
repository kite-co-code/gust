			message: '#^Parameter \$screen of method Gust\\WordPress\\Comments\:\:redirectCommentAdminPage\(\) has invalid type Gust\\WordPress\\WP_Screen\.$#'
			identifier: class.notFound
			count: 1
			path: Gust/WordPress/Comments.php

